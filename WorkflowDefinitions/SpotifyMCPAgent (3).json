    {
      "parameters": {
        "jsCode": "const actions = $('AI Agent').first().json.output.actions;\n\nconst successfulActions = actions.filter(\n  action =>\n    action.status === \"SUCCESS\" &&\n    action.compensation_required\n).reverse();\n\nif (successfulActions.length === 0) {\n  return [\n    {\n      json: {\n        hasCompensations: false\n      }\n    }\n  ];\n}\n\nreturn successfulActions.map(action => ({\n  json: {\n    ...action,\n    hasCompensations: true\n  }\n}));"
      },
