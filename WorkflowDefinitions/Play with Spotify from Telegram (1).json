    {
      "parameters": {
        "jsCode": "// Get raw LLM output\nlet raw = $json[\"text\"] || $json[\"output\"] || \"\";\n\n// Remove Markdown code fences if the model adds them\nraw = raw\n    .replace(/```json\\s*/gi, \"\")\n    .replace(/```\\s*/g, \"\")\n    .trim();\n\nlet parsed;\n\n// Default structure\nconst defaultSongs = [\n    {\n        rank: 1,\n        song_title: null,\n        artist: null,\n        confidence: 0,\n        supporting_clues: []\n    },\n    {\n        rank: 2,\n        song_title: null,\n        artist: null,\n        confidence: 0,\n        supporting_clues: []\n    },\n    {\n        rank: 3,\n        song_title: null,\n        artist: null,\n        confidence: 0,\n        supporting_clues: []\n    }\n];\n\ntry {\n    parsed = JSON.parse(raw);\n} catch (err) {\n    parsed = {\n        songs: defaultSongs\n    };\n}\n\n// Ensure songs is an array\nconst songs = Array.isArray(parsed.songs)\n    ? parsed.songs\n    : defaultSongs;\n\n// Normalize and return each song as a separate n8n item\nreturn songs.map((song, index) => ({\n    json: {\n        rank: song.rank ?? index + 1,\n        song_title: song.song_title ?? null,\n        artist: song.artist ?? null,\n        confidence: Number(song.confidence) || 0,\n        supporting_clues: Array.isArray(song.supporting_clues)\n            ? song.supporting_clues\n            : []\n    }\n}));\n"
      },
