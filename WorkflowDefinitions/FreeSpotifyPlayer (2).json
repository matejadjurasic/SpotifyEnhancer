    {
      "parameters": {
        "jsCode": "// Get raw LLM output\nlet raw = $json[\"text\"] || $json[\"output\"] || \"\";\n\n// Remove Markdown-style ```json ... ``` if present\nraw = raw.replace(/```json\\s*([\\s\\S]*?)```/g, '$1').trim();\n\n// Try to parse JSON safely\nlet parsed;\ntry {\n    parsed = JSON.parse(raw);\n} catch (err) {\n    // If parsing fails, return default safe JSON\n    parsed = {\n        song_title: null,\n        artist: null,\n        confidence: 0,\n        alternatives: [],\n        supporting_clues: []\n    };\n}\n\n// Ensure all keys exist (in case model missed something)\nparsed.song_title = parsed.song_title ?? null;\nparsed.artist = parsed.artist ?? null;\nparsed.confidence = parsed.confidence ?? 0;\nparsed.alternatives = parsed.alternatives ?? [];\nparsed.supporting_clues = parsed.supporting_clues ?? [];\n\n// Return as an item array for n8n\nreturn [parsed];\n"
      },
