    {
      "parameters": {
        "jsCode": "const input = $('Basic LLM Chain').first().json;\n// Parse the JSON string returned by the AI agent\nconst parsed = JSON.parse(input.text);\n\n// Return one n8n item per song\nreturn parsed.songs.map(item => ({\n  json: {\n    artist: item.artist,\n    song: item.song\n  }\n}));"
      },
